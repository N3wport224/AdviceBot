# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# claude-3-5-sonnet is retired; claude-sonnet-5 is the documented replacement.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Instagram credentials for the instaloader adapter.
# Leave blank to use the mock dataset.
INSTAGRAM_USERNAME=
INSTAGRAM_TARGET_PROFILE=sabrina.zohar

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
